    },
    "subtitle": {
      "type": "text"
    },
    "showAllProducts": {
      "type": "boolean",
      "default": true
    },
    "products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product.product"
    }
  }
}
