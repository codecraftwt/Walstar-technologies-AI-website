{
  "collectionName": "components_navigation_nav_items",
  "info": {
    "displayName": "Nav Item",
    "icon": "bulletList"
  },
  "options": {},
  "attributes": {
    "label": {
      "type": "string",
      "required": true
    },
    "route": {
      "type": "string"
    },
    "page": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::page.page"
    },
    "hasDropdown": {
      "type": "boolean",
      "default": false
    },
    "isHighlighted": {
      "type": "boolean",
      "default": false
    },
    "openInNewTab": {
      "type": "boolean",
      "default": false
    },
    "subItems": {
      "type": "component",
      "repeatable": true,
      "component": "navigation.sub-nav-item"
    }
  }
}
